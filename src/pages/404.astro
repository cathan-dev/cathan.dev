---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
    <head>
        <title>404</title>
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/DepartureMono-Regular.woff2"
            crossorigin
        />
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <style>
            body {
                background-color: var(--danger);
                color: var(--bg);
                justify-content: center;
                align-items: center;
                padding: 2ch;
            }

            pre {
                font-family: inherit;
            }

            .error-message {
                font-size: 33px;
                margin: 2ch;
                text-align: center;
            }
        </style>
    </head>
