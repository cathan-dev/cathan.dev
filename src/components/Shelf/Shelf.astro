---
import "./Shelf.css";
import ShelfEntryShort from "./ShelfEntryShort.astro";
import ShelfEntryLong from "./ShelfEntryLong.astro";
import { getCollection } from "astro:content";
const shelfEntries = await getCollection("shelf");
---

<ul class="shelf-list">
    {
        shelfEntries.map((entry) =>
            entry.data.format === "long" ? (
                <ShelfEntryLong entry={entry} />
            ) : (
                <ShelfEntryShort entry={entry} />
            ),
        )
    }
</ul>

<script>
    import "./Shelf.js";
</script>
