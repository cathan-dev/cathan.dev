---
import "./Shelf.css";
const { entry } = Astro.props;
---

<li
    class="shelf-entry shelf-entry-long"
    data-medium={entry.data.medium}
    data-verdict={entry.data.verdict}
>
    <a href={`/shelf/${entry.id}/`} class="shelf-card">
        <p class="shelf-card-pointer" aria-hidden="true"></p>
        <h2 class="shelf-card-title"><span>{entry.data.title}</span></h2>
        <p class="shelf-card-hook">{entry.data.hook}</p>
        <p class="shelf-card-verdict">{entry.data.verdict}</p>
        <p class="shelf-card-medium">{entry.data.medium}</p>
    </a>
</li>
