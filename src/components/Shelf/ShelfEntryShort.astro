---
import "./Shelf.css";
import { render } from "astro:content";
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<li
    class="shelf-entry shelf-entry-short"
    data-medium={entry.data.medium}
    data-verdict={entry.data.verdict}
>
    <details>
        <summary class="shelf-card">
            <p class="shelf-card-pointer" aria-hidden="true"></p>
            <h2 class="shelf-card-title">{entry.data.title}</h2>
            <p class="shelf-card-hook">{entry.data.hook}</p>
            <p class="shelf-card-verdict">{entry.data.verdict}</p>
            <p class="shelf-card-medium">{entry.data.medium}</p>
        </summary>
        <div class="shelf-dropdown prose">
            <Content class="shelf-dropdown-content" />
        </div>
    </details>
</li>
