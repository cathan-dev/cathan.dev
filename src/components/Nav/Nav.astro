---
import "./Nav.css";
import { pages } from "../../data/nav-pages.js";
---

<nav>
    <div class="nav-container">
        <ul class="nav-list">
            {
                pages.map((page) => (
                    <li class="nav-list-item">
                        <a
                            aria-current={
                                page.href === Astro.url.pathname
                                    ? "page"
                                    : undefined
                            }
                            class="nav-link"
                            href={page.href}
                            data-page={page.slug}
                        >
                            <span class="nav-link-text">
                                {"[ " + page.slug}
                                <span class="nav-link-closer">]</span>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
        <div class="nav-input-container">
            <span class="nav-prompt">[</span>
            <input
                id="nav-input"
                class="nav-input"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                aria-label="Type to navigate pages"
                autocorrect="off"
            />
        </div>
        <div class="nav-search-overlay-container">
            <span class="nav-prompt">[</span>
            <p class="nav-overlay-text">
                <span class="nav-before-cursor"></span><span
                    class="nav-text-cursor"></span><span
                    class="nav-after-cursor"></span><span
                    class="nav-error"
                    aria-live="polite"></span>
            </p>
        </div>
    </div>
</nav>

<script>
    import "./Nav.js";
</script>
