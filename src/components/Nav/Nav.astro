---
import "./Nav.css";
import { rootChildren } from "../../data/root-children.js";
import { pageFacets } from "../../data/page-facets.js";
import { buildBridge } from "../../lib/bridge.js";
import { deriveCandidates } from "../../lib/candidates.js";
import { segmentContext } from "../../lib/location.js";
import { getCollection } from "astro:content";
import { execSync } from "node:child_process";
import { readingProgress } from "../../data/reading-status.js";
import { watchingProgress } from "../../data/watching-status.js";
import { getCommitCount } from "../../lib/commits.js";

const pathName = Astro.url.pathname;

const shelfEntries = await getCollection("shelf");

const bridge = buildBridge(rootChildren, pageFacets, { shelf: shelfEntries });
const context = segmentContext(Astro.url.pathname, []);
const candidates = deriveCandidates(bridge, context);

const sortedShelf = shelfEntries.toSorted((a, b) =>
    b.data.date.localeCompare(a.data.date),
);
const timestamp = execSync("git log -1 --format=%cI", {
    encoding: "utf8",
}).trim();
const gitHash = execSync("git log -1 --format=%h", {
    encoding: "utf8",
}).trim();
const commitCount = await getCommitCount();
---

<nav>
    <script
        type="application/json"
        id="nav-bridge"
        set:html={JSON.stringify(bridge)}
    />
    <div class="nav-flavour" aria-hidden="true">
        <p class="nav-title">─ <span>cathan.dev</span> ─────────────────</p>
        <div class="nav-live">
            <p class="nav-live-label">last updated</p>
            <p class="nav-live-timer" data-since={timestamp}>Nd</p>
            <p class="nav-live-info">{"build " + gitHash}</p>
            <p class="nav-live-label">shelf</p>
            <p class="nav-live-value">{shelfEntries.length}</p>
            <p class="nav-live-info">
                {"Recent: " + sortedShelf[0].data.title}
            </p>
            <p class="nav-live-label">projects</p>
            <p class="nav-live-value">0 #bum</p>
            <p class="nav-live-label">reading</p>
            <p class="nav-live-talking">{readingProgress.title}</p>
            <p class="nav-live-info">
                {
                    "p. " +
                        readingProgress.readPages +
                        "/" +
                        readingProgress.totalPages
                }
            </p>
            <!-- might make the colour amber -->
            <p class="nav-live-label">watching</p>
            <p class="nav-live-talking">{watchingProgress.title}</p>
            <p class="nav-live-info">
                {
                    "ep. " +
                        watchingProgress.watchedEpisodes +
                        "/" +
                        watchingProgress.totalEpisodes
                }
            </p>
            <!-- might make the colour amber -->
            <p class="nav-live-label">building</p>
            <a href="/" class="nav-live-link">this website</a>
            {
                commitCount !== null && (
                    <p class="nav-live-info">{commitCount + " commits"}</p>
                )
            }
            <!-- could be a link in future when I have a project -->
        </div>
    </div>
    <div class="nav-container">
        <ul class="nav-list">
            {
                candidates.toReversed().map((candidate) => {
                    const isLink =
                        candidate.kind === "page" || candidate.kind === "entry";
                    const Wrapper = isLink ? "a" : "span";
                    return (
                        <li class={"nav-list-item nav-list-" + candidate.kind}>
                            <Wrapper
                                class="nav-link"
                                href={
                                    isLink
                                        ? context.page + candidate.name + "/"
                                        : undefined
                                }
                            >
                                <span class="nav-link-text">
                                    {"> "}
                                    <span class="nav-link-slug">
                                        {candidate.name}
                                    </span>
                                    {"\u00A0"}
                                </span>
                            </Wrapper>
                        </li>
                    );
                })
            }
        </ul>
        <div class="nav-terminal">
            <div class="nav-input-container">
                <span class="nav-prompt">[</span>
                <input
                    id="nav-input"
                    class="nav-input"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                    aria-label="Type to navigate candidates"
                    autocorrect="off"
                />
            </div>
            <div class="nav-search-overlay-container">
                <span class="nav-prompt">[</span>
                <p class="nav-overlay-text">
                    <span class="nav-tokens"></span><span
                        class="nav-before-cursor"></span><span
                        class="nav-text-cursor"></span><span
                        class="nav-after-cursor"
                    ></span><!-- can't remove nav-after-cursor class -->
                    <span class="nav-error" aria-live="polite"></span>
                </p>
            </div>
        </div>
        <div class="nav-path">
            <p class="nav-path-text">
                → <span class="nav-path-text-real">{"~" + pathName}</span><span
                    class="nav-path-text-preview"></span>
            </p>
        </div>
    </div>
</nav>

<script>
    import "./Nav.js";
    import "./NavLive.js";
</script>
